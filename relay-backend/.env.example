# Google AI Studio API key, issued under a PantaRhei organization Google
# account (not a personal one). Never commit the real value.
GEMINI_API_KEY=

# Cloud Run sets this automatically; only needed for local dev.
PORT=8080

# No Firebase service account key is needed here — on Cloud Run this
# authenticates via Application Default Credentials (the service's own
# identity). For local development, run:
#   gcloud auth application-default login
# first, so the Firebase Admin SDK can find credentials.
